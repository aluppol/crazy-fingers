# See http://help.github.com/ignore-files/ for more about ignoring files.

# Ignore Angular configuration directory
.angular

# Ignore VSCode workspace settings directory
.vscode

# Ignore Yarn cache and configuration directory
.yarn

# compiled output
/dist
/tmp
/out-tsc
# Only exists if Bazel was run
/bazel-out

# dependencies
/node_modules

# profiling files
chrome-profiler-events*.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Agent context (local only)
context.md

# Local sample books for manual testing (copyrighted, never committed)
samples/
